
# Production configuration template
# Replace placeholders before deployment.
# Never commit actual production secrets.

# Database
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/codementor

# JWT
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# Public URLs (example: single HTTPS domain)
STREAMLIT_APP_URL=https://app.example.com
BROWSER_ALLOWED_ORIGINS=https://app.example.com
PUBLIC_API_BASE_URL=https://app.example.com
PUBLIC_URL=https://app.example.com
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

# Internal Docker network
API_BASE_URL=http://backend:8000

# Cookies
COOKIE_SECURE=true

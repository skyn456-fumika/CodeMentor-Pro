# PostgreSQL - Development
DATABASE_URL=postgresql+psycopg://codementor:CHANGE_ME@localhost:5433/codementor

# PostgreSQL - Testing
TEST_DATABASE_URL=postgresql+psycopg://codementor:CHANGE_ME@localhost:5433/codementor_test

# Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# FastAPI / Streamlit
API_BASE_URL=http://localhost:8000
STREAMLIT_APP_URL=http://localhost:8501

# Browser Authentication
BROWSER_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8501
COOKIE_SECURE=false

# JWT
JWT_SECRET_KEY=GENERATE_YOUR_OWN_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker Compose PostgreSQL
POSTGRES_PASSWORD=YOUR_LOCAL_DATABASE_PASSWORD

PUBLIC_API_BASE_URL=http://localhost:8000